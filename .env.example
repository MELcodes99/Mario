# Copy to .env (in the project folder or ~/.mario/.env) and fill in what you have.

# --- strongly recommended ---------------------------------------------------
# A private RPC (Helius / Triton / QuickNode). The public endpoint is heavily rate limited.
RPC_URL=https://api.mainnet-beta.solana.com
# Free key from developers.jup.ag/portal (keyless works at 0.5 requests/second)
JUPITER_API_KEY=
# Enables narrative research. Without it narrative scoring is capped at 5/20 and very few tokens reach 85.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_WEB_SEARCH=true

# --- optional ---------------------------------------------------------------
RUGCHECK_API_KEY=
# Reports + /pause /resume /status /stop from your phone. Get a token from @BotFather;
# chat id = your numeric Telegram id (message @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORT_TZ=Africa/Lagos
# Set if you encrypted the wallet and want unattended live runs
# MARIO_WALLET_PASSPHRASE=

# --- directive parameters (defaults shown; Mario never loosens these by itself) ---
# MIN_LIQUIDITY_USD=50000
# MIN_SCORE=85
# SCAN_CALL_SCORE=85
# RISK_PER_TRADE_PCT=0.25
# MAX_POSITION_PCT=2.0
# MAX_EXPOSURE_PCT=6.0
# MAX_POSITIONS=3
# DAILY_LOSS_PCT=3.0
# MAX_DRAWDOWN_PCT=10.0
# STOP_LOSS_PCT=12
# TP_LEVELS=15,30,50
# TRAILING_PCT=15
# PAPER_START_SOL=10
# MIN_PAPER_TRADES_FOR_LIVE=100
# LIVE_TEST_TRADE=false
# EXTRA_ALLOWED_PROGRAMS=     # program ids you reviewed, if Jupiter routes through a new one
